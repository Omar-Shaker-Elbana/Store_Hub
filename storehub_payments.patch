new file mode 100644
index 0000000..272799e
--- /dev/null
+++ b/templates/payments/_base.html
@@ -0,0 +1,110 @@
+{% load static %}<!DOCTYPE html>
+<html lang="en">
+<head>
+<meta charset="UTF-8">
+<title>{% block title %}Wallet{% endblock %} | StoreHub</title>
+<meta name="viewport" content="width=device-width, initial-scale=1.0">
+<link rel="shortcut icon" href="{% static 'landing/imgs/favicon.png' %}" type="image/x-icon">
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
+<style>
+  :root{
+    --bg:#f8fafc;--surface:#ffffff;--text:#1e293b;--muted:#64748b;--border:#e2e8f0;
+    --accent:#1a49aa;--accent-light:#eef3fd;--accent-2:#3b6fe0;
+    --danger:#ef4444;--danger-light:#fef2f2;--success:#16a34a;--success-light:#f0fdf4;
+    --radius:16px;--radius-sm:10px;--shadow:0 4px 20px rgba(30,41,59,0.06);--shadow-lg:0 12px 40px rgba(26,73,170,0.14);
+  }
+  *{box-sizing:border-box}
+  body{margin:0;background:var(--bg);color:var(--text);font-family:'Inter',system-ui,-apple-system,sans-serif;padding-bottom:70px;animation:fadeIn .5s ease-in-out}
+  h1,h2,h3,h4{font-family:'Poppins',sans-serif;margin:0}
+  a{text-decoration:none;color:inherit}
+  @keyframes fadeIn{from{opacity:0}to{opacity:1}}
+  @keyframes slideInUp{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:translateY(0)}}
+
+  nav{background:var(--surface);display:flex;align-items:center;justify-content:space-between;padding:14px 40px;border-bottom:1px solid var(--border);position:sticky;top:0;z-index:100}
+  .brand img{width:120px;height:auto;display:block}
+  .nav-links{display:flex;align-items:center;gap:26px;flex-wrap:wrap}
+  .nav-links a{color:var(--muted);font-weight:600;font-size:14.5px;transition:color .2s}
+  .nav-links a:hover,.nav-links a.active{color:var(--accent)}
+
+  .wrap{max-width:960px;margin:0 auto;padding:34px 24px 0}
+  .page-head{margin-bottom:26px;animation:slideInUp .5s ease}
+  .page-head h1{font-size:28px}
+  .head-sub{color:var(--muted);font-size:14.5px;font-weight:500;margin:6px 0 0}
+
+  .hero-card{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;border-radius:var(--radius);padding:30px;margin-bottom:20px;box-shadow:var(--shadow-lg);animation:slideInUp .5s ease .05s both}
+  .hero-card .label{font-size:13px;opacity:.9;margin-bottom:10px}
+  .hero-card .amount{font-size:40px;font-weight:800;font-family:'Poppins',sans-serif}
+  .hero-card .amount.negative{color:#fecaca}
+  .hero-card .note{margin-top:10px;font-size:13px;opacity:.88}
+
+  .stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:20px}
+  .stat{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:18px 20px;animation:slideInUp .5s ease both}
+  .stat .s-label{color:var(--muted);font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.03em}
+  .stat .s-num{font-size:24px;font-weight:800;font-family:'Poppins',sans-serif;margin-top:6px}
+  .stat .s-sub{color:var(--muted);font-size:12px;margin-top:4px}
+  .stat .s-num.good{color:var(--success)}
+  .stat .s-num.bad{color:var(--danger)}
+
+  .card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:24px;margin-bottom:20px;animation:slideInUp .5s ease both}
+  .card h3{font-size:16px;margin-bottom:6px}
+  .card .sub{color:var(--muted);font-size:13px;margin:0 0 16px}
+
+  table{width:100%;border-collapse:collapse;font-size:13.5px}
+  th{text-align:left;color:var(--muted);font-weight:600;font-size:11.5px;text-transform:uppercase;padding:8px 10px;border-bottom:1px solid var(--border)}
+  td{padding:10px;border-bottom:1px solid var(--border);vertical-align:top}
+  tr:last-child td{border-bottom:none}
+  tbody tr:hover{background:var(--accent-light)}
+  .r{text-align:right}
+  .plus{color:var(--success);font-weight:700;text-align:right;white-space:nowrap}
+  .minus{color:var(--danger);font-weight:700;text-align:right;white-space:nowrap}
+  .muted{color:var(--muted)}
+  .empty-row{color:var(--muted);padding:16px 0;font-size:13.5px}
+  .pill{display:inline-block;font-size:10.5px;font-weight:700;padding:3px 10px;border-radius:999px;text-transform:uppercase;letter-spacing:.02em;background:var(--accent-light);color:var(--accent);white-space:nowrap}
+  .table-scroll{overflow-x:auto}
+
+  .btn{display:inline-block;border:none;cursor:pointer;background:var(--accent);color:#fff;font-weight:700;font-size:14px;padding:11px 20px;border-radius:var(--radius-sm);font-family:inherit}
+  .btn:hover{background:var(--accent-2)}
+  .btn[disabled]{opacity:.5;cursor:not-allowed}
+  .btn-ghost{background:var(--accent-light);color:var(--accent)}
+  .btn-ghost:hover{background:#dde8fb}
+  .withdraw-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
+  .withdraw-row input[type=number]{flex:1;min-width:160px;max-width:260px;padding:11px 14px;border:1px solid var(--border);border-radius:var(--radius-sm);font-size:15px;font-family:inherit}
+  .pager{display:flex;gap:14px;justify-content:center;margin-top:16px;font-size:13.5px;font-weight:600;color:var(--accent)}
+
+  #toast-stack{position:fixed;top:78px;right:20px;z-index:200;display:flex;flex-direction:column;gap:10px}
+  .toast{background:var(--surface);border:1px solid var(--border);border-left:4px solid var(--accent);box-shadow:var(--shadow);padding:12px 16px;border-radius:var(--radius-sm);font-size:14px;font-weight:500;max-width:340px}
+  .toast.success{border-left-color:var(--success)}
+  .toast.error{border-left-color:var(--danger)}
+
+  @media(max-width:600px){
+    .wrap{padding:22px 16px 0} nav{padding:12px 18px} .page-head h1{font-size:22px}
+    .hero-card{padding:22px} .hero-card .amount{font-size:30px} .card{padding:18px} table{font-size:12px}
+  }
+</style>
+</head>
+<body>
+
+<nav>
+  <a href="{% url 'home' %}" class="brand"><img src="{% static 'landing/imgs/logo.png' %}" alt="StoreHub logo"></a>
+  <div class="nav-links">
+    {% block nav %}{% endblock %}
+    <a href="{% url 'home' %}">Home</a>
+  </div>
+</nav>
+
+<div id="toast-stack">
+  {% for message in messages %}
+    <div class="toast {{ message.tags }}">{{ message }}</div>
+  {% endfor %}
+</div>
+
+<div class="wrap">
+  {% block content %}{% endblock %}
+</div>
+
+<script>
+  setTimeout(function(){var s=document.getElementById('toast-stack');if(s){s.style.transition='opacity .4s';s.style.opacity='0';}},5000);
+</script>
+</body>
+</html>
