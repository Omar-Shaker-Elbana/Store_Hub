@@ -0,0 +1,147 @@
+{% extends "payments/_base.html" %}
+{% block title %}Platform account{% endblock %}
+
+{% block nav %}
+  <a href="{% url 'payments:wallet' %}">My Wallet</a>
+  <a href="{% url 'payments:platform' %}" class="active">Platform</a>
+  <a href="{% url 'admin:index' %}">Admin</a>
+{% endblock %}
+
+{% block content %}
+  <div class="page-head">
+    <h1>Platform account</h1>
+    <p class="head-sub">The website's own money. Visible to superusers only.</p>
+  </div>
+
+  <div class="hero-card">
+    <div class="label">Platform balance</div>
+    <div class="amount {% if summary.balance < 0 %}negative{% endif %}">{% if summary.balance < 0 %}&minus;${{ summary.balance|cut:"-"|floatformat:2 }}{% else %}${{ summary.balance|floatformat:2 }}{% endif %}</div>
+    <div class="note">
+      {% if summary.in_flight > 0 %}
+        ${{ summary.in_flight|floatformat:2 }} of courier and packing pay is advanced for orders still in transit. Once they are delivered, the balance is
+        <strong>${{ summary.balance_after_in_flight|floatformat:2 }}</strong>.
+      {% else %}
+        Nothing is advanced right now: every courier and packing payment has been recovered through delivery fees.
+      {% endif %}
+    </div>
+  </div>
+
+  <div class="stats">
+    <div class="stat"><div class="s-label">1% platform fee</div><div class="s-num good">${{ summary.fees_month|floatformat:2 }}</div><div class="s-sub">This month &middot; ${{ summary.fees_total|floatformat:2 }} all time</div></div>
+    <div class="stat"><div class="s-label">Delivery &amp; handling fees</div><div class="s-num">${{ summary.shipping_month|floatformat:2 }}</div><div class="s-sub">This month &middot; ${{ summary.shipping_total|floatformat:2 }} all time</div></div>
+    <div class="stat"><div class="s-label">Paid to couriers</div><div class="s-num bad">${{ summary.courier_month|floatformat:2 }}</div><div class="s-sub">This month &middot; ${{ summary.courier_total|floatformat:2 }} all time</div></div>
+    <div class="stat"><div class="s-label">Paid to warehouse workers</div><div class="s-num bad">${{ summary.packing_month|floatformat:2 }}</div><div class="s-sub">This month &middot; ${{ summary.packing_total|floatformat:2 }} all time</div></div>
+    <div class="stat"><div class="s-label">Net this month</div><div class="s-num {% if summary.month_net < 0 %}bad{% else %}good{% endif %}">{% if summary.month_net < 0 %}&minus;${{ summary.month_net|cut:"-"|floatformat:2 }}{% else %}${{ summary.month_net|floatformat:2 }}{% endif %}</div><div class="s-sub">Since {{ summary.month_start|date:"M j" }}</div></div>
+    <div class="stat"><div class="s-label">Orders settled</div><div class="s-num">{{ summary.orders_settled }}</div><div class="s-sub">All time</div></div>
+  </div>
+
+  <div class="card">
+    <h3>Why this account can't end the month negative</h3>
+    <p class="sub" style="margin:0">
+      Couriers ($20 per trip) and warehouse workers ($10 per package) are paid from this account the moment they finish.
+      The shopper pays a delivery &amp; handling fee equal to exactly those costs ($20 &times; (stores + 1) + $10), collected with the order's cash on delivery.
+      So every delivered order leaves this account with its 1% fee as pure profit; the only dips are short-lived advances on orders still in transit.
+    </p>
+  </div>
+
+  <div class="card">
+    <h3>1% earned per order</h3>
+    <p class="sub">The most recent settled orders.</p>
+    <div class="table-scroll">
+      <table>
